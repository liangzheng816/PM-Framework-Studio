{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/_next/*", "/*.ico", "/*.svg", "/*.png", "/*.webp", "/m365-mc-agent/*", "/spo-lmc-agent/*", "/myaipeer/*"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-XSS-Protection": "0",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://pmstudio-api.bluecliff-2f3ceb96.westus2.azurecontainerapps.io; frame-ancestors 'none'"
  },
  "routes": [
    {
      "route": "/m365-mc-agent",
      "rewrite": "/m365-mc-agent/index.html"
    },
    {
      "route": "/spo-lmc-agent",
      "rewrite": "/spo-lmc-agent/index.html"
    },
    {
      "route": "/myaipeer",
      "rewrite": "/myaipeer/index.html"
    },
    {
      "route": "/_next/static/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.ico",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    }
  ]
}
